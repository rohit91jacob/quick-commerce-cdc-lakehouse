# Copy to .env and change the secrets. Every QC_* variable is read by src/qcommerce/settings.py.

# --- secrets used by docker compose ---------------------------------------------------------------
QC_PG_ADMIN_PASSWORD=change-me-postgres
QC_PG_APP_PASSWORD=change-me-app
QC_PG_DEBEZIUM_PASSWORD=change-me-debezium
ICEBERG_DB_PASSWORD=change-me-iceberg
DAGSTER_DB_PASSWORD=change-me-dagster
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-s3-secret

# --- generator ------------------------------------------------------------------------------------
QC_GEN_SEED=42
# QC_GEN_CITIES=2
# QC_GEN_STORES_PER_CITY=3
# QC_GEN_PRODUCTS=320
# QC_GEN_CUSTOMERS=2500
# QC_GEN_RIDERS_PER_STORE=28
# QC_GEN_BASE_ORDERS_PER_STORE_HOUR=24
# QC_GEN_PROMISED_MINUTES=10
QC_DEMO_BACKFILL_HOURS=24

# --- writer ---------------------------------------------------------------------------------------
# QC_WRITER_TRIGGER_SECONDS=10
# QC_WRITER_MAX_OFFSETS_PER_TRIGGER=100000
# QC_WRITER_MERGE_RETRIES=5

# --- host ports (change if they clash) ------------------------------------------------------------
QC_PG_HOST_PORT=5432
QC_CONNECT_HOST_PORT=8083
QC_TRINO_HOST_PORT=8080
QC_WRITER_HOST_PORT=9405
QC_DAGSTER_HOST_PORT=3000

# --- misc -----------------------------------------------------------------------------------------
QC_LOG_LEVEL=INFO
DBT_TARGET=dev
# QC_ALERT_WEBHOOK_URL=https://hooks.example.com/...   # Dagster run-failure alerts
